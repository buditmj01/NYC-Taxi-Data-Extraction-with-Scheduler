# NYC Taxi Data Pipeline - Environment Variables
# Copy this file to .env and fill in your credentials

# ============================================
# DISCORD CONFIGURATION
# ============================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ============================================
# GMAIL SMTP CONFIGURATION
# ============================================
# IMPORTANT: Use Gmail App Password, NOT your regular Gmail password!
# How to get App Password:
# 1. Enable 2-Step Verification on your Gmail account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create new app password for "Mail"
# 4. Copy the 16-character password here (no spaces)

GMAIL_SENDER_EMAIL=your-email@gmail.com
GMAIL_SENDER_PASSWORD=your-16-char-app-password

# Recipient emails (comma-separated)
GMAIL_RECIPIENT_EMAILS=recipient1@gmail.com,recipient2@gmail.com

# SMTP Server Settings (usually no need to change)
GMAIL_SMTP_SERVER=smtp.gmail.com
GMAIL_SMTP_PORT=587

# ============================================
# POSTGRESQL CONFIGURATION
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nyc_taxi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
