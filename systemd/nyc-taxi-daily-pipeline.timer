[Unit]
Description=NYC Taxi Daily Pipeline Timer
Documentation=https://github.com/purwadhika-project/jcdeah007-capstone1
Requires=nyc-taxi-daily-pipeline.service

[Timer]
# Run daily at 2:00 AM
OnCalendar=daily
OnCalendar=*-*-* 02:00:00

# If the system was powered off, run on next boot
Persistent=true

# Randomize start time by up to 5 minutes to avoid load spikes
RandomizedDelaySec=5min

# Ensure timer is accurate
AccuracySec=1min

[Install]
WantedBy=timers.target
